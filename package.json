{
  "name": "niceaxis",
  "version": "0.1.0",
  "description": "Tiny framework-agnostic axis/scale utilities for charts: nice ticks, linear/log scales, and SI-ish tick formatting. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "axis",
    "scale",
    "ticks",
    "chart",
    "d3-ish",
    "linear-scale",
    "log-scale",
    "tick-format"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
